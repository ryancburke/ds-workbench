# Copy to .env and fill in values
ANTHROPIC_API_KEY=sk-ant-...

# Where Claude is reached (default: the Anthropic API). For an organisation-approved route:
#   anthropic | aws | bedrock | vertex | google_cloud | foundry
# Platform providers use their own standard credentials (AWS profile/role, Google ADC, Azure),
# not ANTHROPIC_API_KEY, and the *_MODEL settings below must be that platform's model IDs.
# ANTHROPIC_PROVIDER=anthropic
# ANTHROPIC_BASE_URL=            # optional approved gateway/proxy URL

# Set to "false" to connect to real Databricks
LOCAL_DEV_MODE=true

# Dash debug mode: dev tools, error overlay and hot reload. Set to "false" for demos.
DEBUG=true

# Databricks (only needed when LOCAL_DEV_MODE=false)
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id

# Simulation scheduler interval in hours. 0 (default) = manual: run from the
# Feedback page or run_sim.py so each run can be tied to a change.
# SIM_INTERVAL_HOURS=0

# ── Models (optional — defaults live in config.py) ──────────────────────────
# Run the benchmark suite before changing a skill model or effort.
# REASONING_MODEL=claude-sonnet-5-5    # DQ Pass 1
# ANALYSIS_MODEL=claude-sonnet-5-5     # model_selector, join_auditor Pass 1
# GENERAL_MODEL=claude-sonnet-5-5      # EDA, MLOps, NL→Spark, FE, experiment tracker
# LEAKAGE_MODEL=claude-opus-5-5        # leakage Pass 1
# STRUCTURED_MODEL=claude-haiku-5-5    # all Pass 2 — must accept forced tool_choice
# SCOUT_MODEL=claude-sonnet-5-5        # Data Scout catalog-search loop
# SIM_MODEL=claude-sonnet-5-5          # agent persona think/interpret
# SIM_JUDGE_MODEL=claude-opus-5-5      # agent debrief, rating, reflection
# CODE_MODEL=claude-sonnet-5-5         # feedback-loop code drafting

# Effort per role: low | medium | high | xhigh | max
# REASONING_EFFORT=high
# ANALYSIS_EFFORT=high
# GENERAL_EFFORT=high
# LEAKAGE_EFFORT=medium
# SCOUT_EFFORT=medium
# SIM_EFFORT=low
# SIM_JUDGE_EFFORT=low
# CODE_EFFORT=medium

# Data discovery (Data Scout)
# CATALOG_BACKEND=synthetic          # synthetic | unity_catalog (adapter: later milestone)
# CATALOG_FIXTURE=retail_marketing
# REQUIRE_CONFIRMED_SPEC=false        # true: scouting needs session.confirm_spec() first
